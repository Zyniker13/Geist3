#!/bin/sh
# rules-cli — the Parlor ruleset tool (§11.4). The implementation lives in
# the sibling SwiftPM package (rules-cli.d); this wrapper builds it once in
# release mode and then execs it. Replaces the P0 stub; resolve/simulate/
# replay/fuzz arrive with P3+.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BIN="$DIR/rules-cli.d/.build/release/rules-cli"
if [ ! -x "$BIN" ]; then
    (cd "$DIR/rules-cli.d" && swift build -c release >/dev/null 2>&1)
fi
exec "$BIN" "$@"
